APP_NAME=DecisionHub

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=decision_hub

# ---- CORS ----
CORS_ORIGINS=*

# ---- JWT ----
# Secret key để ký/kiểm tra access token. Sinh key ngẫu nhiên:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Nếu để trống, ứng dụng sẽ tự sinh key tạm cho tiến trình hiện tại
# (token sẽ mất hiệu lực sau khi restart).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
